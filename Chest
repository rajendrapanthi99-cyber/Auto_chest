-- Core Flying & Logic System
local isFarming = false
local flySpeed = 70 -- Adjust this value to fly faster or slower

-- Clean function to smoothly move the character to target coordinates
local function flyToTarget(targetPart)
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    
    -- Loop moving towards the target until close enough
    while isFarming and targetPart and targetPart.Parent and (rootPart.Position - targetPart.Position).Magnitude > 4 do
        local currentPos = rootPart.Position
        local targetPos = targetPart.Position
        local direction = (targetPos - currentPos).Unit
        
        -- Incrementally shift position frame-by-frame
        rootPart.CFrame = CFrame.new(currentPos + (direction * (flySpeed * task.wait())))
        rootPart.Velocity = Vector3.new(0, 0, 0) -- Kill gravity/velocity drops while flying
    end
end

-- Primary looping function to track down map elements
local function startFarmingLoop()
    while isFarming do
        local targetChest = nil
        
        -- Query existing elements in workspace for game chests
        for _, obj in pairs(workspace:GetChildren()) do
            if string.find(obj.Name, "Chest") and obj:IsA("BasePart") then
                targetChest = obj
                break
            end
        end
        
        if targetChest then
            StatusLabel.Text = "Status: Flying to " .. targetChest.Name .. "..."
            flyToTarget(targetChest)
            task.wait(0.5) -- Small rest duration to let the server process the reward pick-up
        else
            StatusLabel.Text = "Status: Searching for active chests..."
            task.wait(2)
        end
    end
end

-- UI Toggle Triggers
ToggleButton.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    
    if isFarming then
        ToggleButton.Text = "STOP FLY FARM"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(40, 167, 69) -- Eco Emerald Green
        StatusLabel.Text = "Status: Active"
        task.spawn(startFarmingLoop)
    else
        ToggleButton.Text = "START FLY FARM"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(220, 53, 69) -- Return to Crimson
        StatusLabel.Text = "Status: Stopped"
    end
end)
