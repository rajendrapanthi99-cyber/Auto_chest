-- Core Functionality Logic
local farmingActive = false

-- Function to safely sweep the map and collect chests
local function collectChests()
    while farmingActive do
        local foundChest = false
        -- Search all elements currently rendered in the workspace
        for _, object in pairs(workspace:GetChildren()) do
            if string.find(object.Name, "Chest") and object:IsA("BasePart") then
                foundChest = true
                StatusLabel.Text = "Status: Teleporting to chest..."
                
                -- Instantly reposition player to the chest coordinates
                local player = game.Players.LocalPlayer
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.CFrame = object.CFrame
                end
                
                task.wait(1.5) -- Essential structural pause to allow server pickup registration
            end
        end
        
        if not foundChest then
            StatusLabel.Text = "Status: Waiting for new chests..."
            task.wait(3) -- Delay before rescanning the environment map
        end
    end
end

-- UI Interaction Event
ToggleButton.MouseButton1Click:Connect(function()
    farmingActive = not farmingActive
    
    if farmingActive then
        ToggleButton.Text = "STOP FARM"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(46, 204, 113) -- Emerald green (Active state)
        StatusLabel.Text = "Status: Running"
        -- Fire execution loop on a background thread
        task.spawn(collectChests)
    else
        ToggleButton.Text = "START FARM"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(235, 64, 52) -- Return to red
        StatusLabel.Text = "Status: Stopped"
    end
end)
